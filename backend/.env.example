# IdeaLens backend environment
# Copy this file to `.env` and adjust values for your machine.
# Never commit a real `.env` file (it is git-ignored).

# Runtime environment: development | test | production
ENVIRONMENT=development

# SQLAlchemy connection string. PostgreSQL (psycopg) is the production driver;
# SQLite is supported for local development and tests, e.g.:
#   DATABASE_URL=sqlite+pysqlite:///./idealens.db
DATABASE_URL=postgresql+psycopg://idealens:idealens@localhost:5432/idealens

# Redis connection string. Queue/cache infrastructure; runs fall back to an
# in-process executor when Redis is unreachable.
REDIS_URL=redis://localhost:6379/0

# Allowed CORS origins for the Next.js frontend (JSON list).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Max seconds for the /health dependency probes.
DEPENDENCY_CHECK_TIMEOUT_SECONDS=2

# --- Research pipeline -------------------------------------------------------
# Comma-separated source adapters enabled for retrieval.
ENABLED_ADAPTERS=semantic_scholar,crossref,arxiv,github

# Default results requested per query per adapter.
RETRIEVAL_LIMIT_PER_SOURCE=10

# Max concurrent outbound retrieval requests (global protection).
RETRIEVAL_MAX_CONCURRENCY=4

# Max seconds for a single outbound HTTP call.
HTTP_TIMEOUT_SECONDS=30.0

# Max retries for transient failures (network/5xx/429).
HTTP_MAX_RETRIES=3

# Character cap for stored evidence excerpts.
EXCERPT_CHAR_LIMIT=500

# --- Queue / workers ---------------------------------------------------------
QUEUE_KEY=idealens:research:queue
QUEUE_BLOCK_SECONDS=5

# --- Optional AI / embedding providers (secrets are env-only; leave blank) ---
# AI_PROVIDER=none
# AI_API_KEY=
# EMBEDDING_PROVIDER=none
# EMBEDDING_API_KEY=
# GITHUB_TOKEN=
# SEMANTIC_SCHOLAR_API_KEY=