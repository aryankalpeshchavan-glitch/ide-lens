# IdeaLens backend environment — M1 build
# Copy this file to `.env` and adjust values for your machine.
# Never commit a real `.env` file (it is git-ignored).

# Runtime environment: development | test | production
ENVIRONMENT=development

# PostgreSQL connection string (SQLAlchemy / psycopg driver).
# The backend boots without a running database; this is used by later
# milestones for persistence and today by the /health database probe.
DATABASE_URL=postgresql+psycopg://idealens:idealens@localhost:5432/idealens

# Redis connection string. Queues/cache are not implemented in M1; this is an
# infrastructure boundary and the /health redis probe.
REDIS_URL=redis://localhost:6379/0

# Allowed CORS origins for the Next.js frontend (JSON list).
CORS_ORIGINS=["http://localhost:3000"]

# Max seconds for the /health dependency probes.
DEPENDENCY_CHECK_TIMEOUT_SECONDS=2